# Domena na którą przyjmujesz maile testowe (musi mieć rekord MX → ten serwer)
MAIL_DOMAIN=testmail.b-1.pl

# Hostname serwera pocztowego (rekord A + rDNS/PTR)
POSTFIX_HOSTNAME=mx.testmail.b-1.pl

# Redis – nazwa serwisu Docker jako host
REDIS_URL=redis://redis:6379/0

# TTL joba w sekundach (1h)
JOB_TTL=3600

# Rspamd – wewnętrzny URL
RSPAMD_URL=http://rspamd:11333

# CORS – domena frontendu. Na produkcji NIE używaj "*"
CORS_ORIGIN=https://narzedzia.lh.pl
